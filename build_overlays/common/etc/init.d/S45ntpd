#!/bin/sh
#
# Starts BusyBox ntpd only after explicit local configuration.  The printer is
# intentionally usable without outbound time synchronization.
#
NTP_CONFIG="${AD5M_NTP_CONFIG:-/etc/default/ad5m-ntp}"
PID_FILE=/run/ntpd.pid

read_config_value() {
    key=$1
    match_count=$(sed -n "/^$key=/p" "$NTP_CONFIG" | wc -l)
    if [ "$match_count" -ne 1 ]; then
        return 1
    fi
    sed -n "s/^$key=//p" "$NTP_CONFIG"
}

NTP_CONFIG_VALID=1
if [ -r "$NTP_CONFIG" ]; then
    NTP_ENABLED=$(read_config_value NTP_ENABLED) || NTP_CONFIG_VALID=0
    NTP_SERVER=$(read_config_value NTP_SERVER) || NTP_CONFIG_VALID=0
else
    NTP_ENABLED=0
    NTP_SERVER=
fi

: "${NTP_ENABLED:=0}"
: "${NTP_SERVER:=}"
case "$NTP_ENABLED" in
    0|1)
        ;;
    *)
        NTP_CONFIG_VALID=0
        ;;
esac
case "$NTP_SERVER" in
    *[!A-Za-z0-9._:-]*)
        NTP_CONFIG_VALID=0
        ;;
esac

start() {
	if [ "$NTP_CONFIG_VALID" != "1" ]; then
		printf "BusyBox ntpd not started (invalid NTP configuration)\n" >&2
		return 1
	fi

	if [ "$NTP_ENABLED" != "1" ]; then
		printf "BusyBox ntpd disabled (no configured time source)\n"
		return 0
	fi

	if [ -z "$NTP_SERVER" ]; then
		printf "BusyBox ntpd not started (NTP_SERVER is empty)\n" >&2
		return 1
	fi

	printf "Starting busybox ntpd: "
	start-stop-daemon -S -b -m -p "$PID_FILE" --exec /usr/sbin/ntpd -- -n -S fake-hwclock -p "$NTP_SERVER"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
stop() {
	printf "Stopping busybox ntpd: "
	start-stop-daemon -K -q -p $PID_FILE
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
restart() {
	stop
	start
}

case "$1" in
  start)
  	start
	;;
  stop)
  	stop
	;;
  restart|reload)
  	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
