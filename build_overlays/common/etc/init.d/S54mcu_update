#!/bin/sh
#
# Automatic MCU flashing is intentionally disabled for the AD5M base image.
#
# A Klipper host-version mismatch is not evidence that either controller needs
# firmware, that the bundled image matches this board, or that a recovery path
# exists.  Keep this init slot as an explicit no-op so existing boot ordering
# cannot turn a normal boot into a firmware operation.  A future explicit MCU
# workflow must implement AD5M-034's per-board journal and recovery contract.
#

start() {
    echo "Automatic MCU update is disabled; no firmware operation requested."
}

case "$1" in
  start)
        start
        ;;
  stop)
        ;;
  *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac

exit $?
