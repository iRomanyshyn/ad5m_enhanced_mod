From 4c133b291a2c5b2f0375aa966aac7c6adf563c83 Mon Sep 17 00:00:00 2001
From: AD5M Enhanced Mod <noreply@example.invalid>
Date: Tue, 27 Oct 2026 12:00:00 +0200
Subject: [PATCH] disable runtime pip recovery

The image supplies an audited, fixed dependency closure. Falling back to
network package installation at printer runtime would bypass Buildroot source
hashes and licenses, while also making boot behavior depend on a network
connection. Optional components with extra dependencies remain unavailable
until they are deliberately packaged.

Signed-off-by: AD5M Enhanced Mod <noreply@example.invalid>
---
 moonraker/server.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/moonraker/server.py b/moonraker/server.py
index 5d31ae8..a7dc4f9 100755
--- a/moonraker/server.py
+++ b/moonraker/server.py
@@ -324,4 +324,8 @@
     def try_pip_recovery(self, missing_module: str) -> bool:
+        logging.error(
+            "Module '%s' is unavailable; runtime pip recovery is disabled "
+            "in this image.", missing_module)
+        return False
         if self.pip_recovery_attempted:
             return False
         self.pip_recovery_attempted = True
